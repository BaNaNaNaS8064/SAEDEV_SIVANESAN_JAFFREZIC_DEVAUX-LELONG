                  <Label fx:id="labelNomCellule" alignment="CENTER" prefHeight="30.0" prefWidth="139.0" textAlignment="CENTER" />
                  <Label fx:id="labelNiveauCellule" prefHeight="26.0" prefWidth="131.0" />
                  <Button alignment="CENTER_RIGHT" mnemonicParsing="false" prefHeight="34.0" prefWidth="29.0" text="X" fx:id="boutonQuitter" onMouseClicked="#clickBoutonQuitter"/>
               </children>
            </HBox>
            <VBox prefHeight="144.0" prefWidth="160.0">
               <children>
                  <HBox prefHeight="20.0" prefWidth="160.0">
                     <children>
                        <Label text="Dégats : " />
                        <Label fx:id="labelDegatsCellule"/>
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="10.0" prefHeight="18.0" prefWidth="160.0">
                     <children>
                        <Label text="Portée : " />
                        <Label fx:id="labelPorteeCellule"/>
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="30.0" prefHeight="18.0" prefWidth="160.0">
