                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="48.0" prefHeight="18.0" prefWidth="160.0">
                     <children>
                        <Label text="Cout amélioration : " />
                        <Label fx:id="labelCoutAmelioration"/>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Button mnemonicParsing="false" text="Améliorer" fx:id="boutonAmelioration">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Button>
                  <Button mnemonicParsing="false" text="Supprimer" fx:id="boutonSupprimer" onMouseClicked="#clickBoutonSupprimer">
                     <font>
                        <Font size="10.0" />
                     </font>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</Pane>
